# Supabase - klucze z dashboardu projektu (Settings > API)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# Nazwa nowego household (zostanie utworzony automatycznie)
HOUSEHOLD_NAME=Moja Rodzina

# --- assign-to-household.mjs: przypisanie osoby do istniejącej rodziny ---
# Email osoby do dołączenia (musi mieć już konto w aplikacji)
MEMBER_EMAIL=zona@example.com
# Email właściciela rodziny — skrypt znajdzie po nim household_id
OWNER_EMAIL=pawel.uchyla@gmail.com
# Alternatywnie: wskaż gospodarstwo wprost (pomija OWNER_EMAIL)
# HOUSEHOLD_ID=00000000-0000-0000-0000-000000000000

# Ścieżki do plików CSV wyeksportowanych z Google Sheets
# (File > Download > Comma Separated Values)
CSV_TRANSAKCJE=./csv/Transakcje.csv
CSV_KATEGORIE=./csv/Kategorie.csv
CSV_OSOBY=./csv/Osoby.csv
CSV_BUDZETY=./csv/Budżety.csv
