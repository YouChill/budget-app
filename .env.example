# ── Supabase (wymagane) ───────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://twoj-projekt.supabase.co
VITE_SUPABASE_ANON_KEY=twoj-anon-key

# ── Supabase Auth — URL przekierowania po logowaniu OAuth ────────────────────
# W Supabase Dashboard → Authentication → URL Configuration → Redirect URLs
# dodaj tę samą wartość (np. https://twoja-domena.vercel.app)
VITE_SUPABASE_REDIRECT_URL=http://localhost:5173

# ── AI kategoryzacja (opcjonalnie) ──────────────────────────────────────────
# OPENAI_API_KEY — klucz zostaje wyłącznie po stronie serwera (Vercel).
# Nigdy nie dodawaj prefiksu VITE_ do tego klucza.
OPENAI_API_KEY=sk-...

# VITE_AI_ENABLED — bezpieczna flaga widoczna w przeglądarce (true/false).
# Włącz gdy OPENAI_API_KEY jest ustawiony w środowisku Vercel.
VITE_AI_ENABLED=false

# Lokalne testy AI: zamiast `npm run dev` używaj `vercel dev`,
# wtedy /api/embeddings działa lokalnie z OPENAI_API_KEY z pliku .env.
