VITE_SUPABASE_URL=https://twoj-projekt.supabase.co
VITE_SUPABASE_ANON_KEY=twoj-anon-key

# ── Funkcje serverless /api/* (opcjonalnie) ─────────────────────────────────
# Domyślnie używają wartości VITE_*. Ustaw jawnie, jeśli funkcje mają łączyć
# się z innym projektem niż frontend.
# SUPABASE_URL=https://twoj-projekt.supabase.co
# SUPABASE_ANON_KEY=twoj-anon-key

# ── HMAC rachunków kontrahentów (kolejka importu) ───────────────────────────
# Sekret po stronie serwera (bez prefiksu VITE_), ≥ 32 bajty w base64.
# Generowanie: openssl rand -base64 48
# Bez niego import działa, ale dowody nie dostają rachunek_hmac.
# Zmiana klucza unieważnia zapisane HMAC — nie rotuj bez przeliczenia bazy.
RACHUNEK_HMAC_KEY=

# ── AI kategoryzacja (opcjonalnie) ──────────────────────────────────────────
# OPENAI_API_KEY — klucz zostaje wyłącznie po stronie serwera (Vercel).
# Nigdy nie dodawaj prefiksu VITE_ do tego klucza.
OPENAI_API_KEY=sk-...

# VITE_AI_ENABLED — bezpieczna flaga widoczna w przeglądarce (true/false).
# Włącz gdy OPENAI_API_KEY jest ustawiony w środowisku Vercel.
VITE_AI_ENABLED=false

# Lokalne testy AI: zamiast `npm run dev` używaj `vercel dev`,
# wtedy /api/embeddings działa lokalnie z OPENAI_API_KEY z pliku .env.
